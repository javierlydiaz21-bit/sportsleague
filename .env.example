# Copia este archivo como .env para personalizar el entorno local (docker compose lo lee solo).
# Todos los valores tienen un valor por defecto de desarrollo: NO los uses en producción.

# Secretos compartidos
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_TOKEN=dev-internal-token-change-me

# Cuenta de administrador que se crea al iniciar el Auth Service
ADMIN_EMAIL=admin@sportsleague.com
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Administrador

# Credenciales de PostgreSQL (un usuario por microservicio, misma contraseña en local)
POSTGRES_PASSWORD=postgres
SERVICES_DB_PASSWORD=sl_dev_pass
ANALYTICS_RO_PASSWORD=sl_ro_pass

# URLs públicas que usa el navegador (se incrustan al construir la imagen de la web)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=http://localhost:4006

# Orígenes que aceptan el gateway (CORS) y el WebSocket; actualízalos si cambias el puerto de la web
CORS_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting del API Gateway (solicitudes por minuto)
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=300
RATE_LIMIT_READ=1200

LOG_LEVEL=info
