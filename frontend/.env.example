# URL pública del API Gateway (la usa el navegador)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canal WebSocket del Live Score Service
NEXT_PUBLIC_WS_URL=http://localhost:4006
# Zona horaria y desfase de la liga
NEXT_PUBLIC_TIMEZONE=America/Bogota
NEXT_PUBLIC_UTC_OFFSET=-05:00
# URL del gateway vista desde el servidor de Next.js (SSR). En Docker: http://api-gateway:4000
API_INTERNAL_URL=http://localhost:4000
# Enlaces de Administración → Sistema. Si NEXT_PUBLIC_API_URL es local (localhost o 127.0.0.1),
# apuntan a http://localhost:3100 y http://localhost:9090. En producción solo aparecen si se definen
# (p. ej. el dashboard público de Grafana Cloud).
# NEXT_PUBLIC_GRAFANA_URL=
# NEXT_PUBLIC_PROMETHEUS_URL=
