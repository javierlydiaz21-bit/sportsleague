# URL pública del API Gateway (la usa el navegador)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canal WebSocket del Live Score Service
NEXT_PUBLIC_WS_URL=http://localhost:4006
# Zona horaria y desfase de la liga
NEXT_PUBLIC_TIMEZONE=America/Bogota
NEXT_PUBLIC_UTC_OFFSET=-05:00
# URL del gateway vista desde el servidor de Next.js (SSR). En Docker: http://api-gateway:4000
API_INTERNAL_URL=http://localhost:4000
