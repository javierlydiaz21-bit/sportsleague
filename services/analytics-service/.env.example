# Variables para ejecutar analytics-service fuera de Docker (npm run start:dev).
# Copia este archivo como .env; los valores apuntan a la infraestructura de docker compose.
PORT=4009
DATABASE_URL=postgresql://analytics_user:sl_dev_pass@localhost:5440/analytics_db
FIXTURE_REPLICA_URL=postgresql://analytics_ro:sl_ro_pass@localhost:5440/fixture_db
LIVESCORE_REPLICA_URL=postgresql://analytics_ro:sl_ro_pass@localhost:5440/livescore_db
STATISTICS_REPLICA_URL=postgresql://analytics_ro:sl_ro_pass@localhost:5440/statistics_db
ETL_INTERVAL_MINUTES=2
ETL_INITIAL_DELAY_SECONDS=20
ETL_DISABLED=false
REDIS_URL=redis://localhost:6380
INTERNAL_API_TOKEN=dev-internal-token-change-me
LOG_LEVEL=info
LEAGUE_UTC_OFFSET=-05:00
LEAGUE_TIMEZONE=America/Bogota
