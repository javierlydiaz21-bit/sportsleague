# Variables para ejecutar auth-service fuera de Docker (npm run start:dev).
# Copia este archivo como .env; los valores apuntan a la infraestructura de docker compose.
PORT=4001
DATABASE_URL=postgresql://auth_user:sl_dev_pass@localhost:5440/auth_db
JWT_SECRET=dev-jwt-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=admin@sportsleague.com
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Administrador
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REDIS_URL=redis://localhost:6380
INTERNAL_API_TOKEN=dev-internal-token-change-me
LOG_LEVEL=info
LEAGUE_UTC_OFFSET=-05:00
LEAGUE_TIMEZONE=America/Bogota
