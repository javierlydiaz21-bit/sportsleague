# Variables para ejecutar live-score-service fuera de Docker (npm run start:dev).
# Copia este archivo como .env; los valores apuntan a la infraestructura de docker compose.
PORT=4006
DATABASE_URL=postgresql://livescore_user:sl_dev_pass@localhost:5440/livescore_db
FIXTURE_SERVICE_URL=http://localhost:4004
REFEREE_SERVICE_URL=http://localhost:4005
TEAM_SERVICE_URL=http://localhost:4003
WS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6380
INTERNAL_API_TOKEN=dev-internal-token-change-me
LOG_LEVEL=info
LEAGUE_UTC_OFFSET=-05:00
LEAGUE_TIMEZONE=America/Bogota
