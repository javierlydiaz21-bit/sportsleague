# Variables para ejecutar notification-service fuera de Docker (npm run start:dev).
# Copia este archivo como .env; los valores apuntan a la infraestructura de docker compose.
PORT=4008
DATABASE_URL=postgresql://notification_user:sl_dev_pass@localhost:5440/notification_db
TEAM_SERVICE_URL=http://localhost:4003
REDIS_URL=redis://localhost:6380
INTERNAL_API_TOKEN=dev-internal-token-change-me
LOG_LEVEL=info
LEAGUE_UTC_OFFSET=-05:00
LEAGUE_TIMEZONE=America/Bogota
# Correo real con Gmail (apps-script/enviar-correo.gs). Vacías = correos simulados.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
MAIL_SKIP_DOMAINS=demo.com,example.com,sportsleague.com
WEB_URL=http://localhost:3000
# Push real en el navegador (Web Push): npx web-push generate-vapid-keys. Vacías = push simulado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sportsleague.com
