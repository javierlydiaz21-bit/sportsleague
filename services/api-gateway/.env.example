# Variables para ejecutar api-gateway fuera de Docker (npm run start:dev).
# Copia este archivo como .env; los valores apuntan a la infraestructura de docker compose.
PORT=4000
JWT_SECRET=dev-jwt-secret-change-me
CORS_ORIGINS=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:4001
LEAGUE_SERVICE_URL=http://localhost:4002
TEAM_SERVICE_URL=http://localhost:4003
FIXTURE_SERVICE_URL=http://localhost:4004
REFEREE_SERVICE_URL=http://localhost:4005
LIVE_SCORE_SERVICE_URL=http://localhost:4006
STATISTICS_SERVICE_URL=http://localhost:4007
NOTIFICATION_SERVICE_URL=http://localhost:4008
ANALYTICS_SERVICE_URL=http://localhost:4009
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=300
RATE_LIMIT_READ=1200
RATE_LIMIT_WINDOW_SECONDS=60
# Espera máxima a un microservicio (Render Free usa 60000 para dar tiempo a que despierte)
PROXY_TIMEOUT_MS=15000
# Despertador de Render Free: hace ping a /health de los servicios como mucho cada WAKE_INTERVAL_MS
WAKE_SERVICES=false
WAKE_INTERVAL_MS=240000
REDIS_URL=redis://localhost:6380
INTERNAL_API_TOKEN=dev-internal-token-change-me
LOG_LEVEL=info
LEAGUE_UTC_OFFSET=-05:00
LEAGUE_TIMEZONE=America/Bogota
